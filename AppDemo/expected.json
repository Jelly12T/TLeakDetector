    {
      "id": "L01",
      "name": "Block property captures self",
      "family": "Objective-C screens",
      "language": "objc",
      "expectation": "leak_cycle",
      "navigation": "push_pop",
      "pattern": "@property (copy) block gán ^{ [self reload]; }",
      "retainPath": "L01 → _onRefresh → block → L01",
      "cause": [
        "cycle"
      ],
      "objects": [
        {
          "log": "L01",
          "className": "LL01BlockPropertyViewController",
          "leaks": true,
          "kind": "screen"
        }
      ]
    },
